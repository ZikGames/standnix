{
  perSystem =
    { config, pkgs, ... }:
    {
      packages.g3m =
        pkgs.callPackage
          (
            {
              lib,
              python3Packages,
              fetchFromGitHub,
              playsound3,
              autoPatchelfHook,
              makeDesktopItem,
              copyDesktopItems,
            }:
            let
              pythonDeps = with pkgs.python3Packages; [
                defusedxml
                playsound3
                psutil
                py7zr
                pyqt6
                python-dotenv
                rarfile
                requests
                urllib3
              ];
              # синхронизировано с [project.optional-dependencies].test —
              # pytest-cov/pytest-html в pyproject.toml больше нет (3.3.3)
              testDeps = with pkgs.python3Packages; [
                pytest
                pytest-mock
                pytest-qt
                responses
              ];
            in
            pkgs.python3Packages.buildPythonApplication (finalAttrs: {

              pname = "g3m";
              version = "3.3.3";
              pyproject = true;
              __structuredAttrs = true;

              src = fetchFromGitHub {
                owner = "y114git";
                repo = "G3M";
                tag = finalAttrs.version;
                # версия сменилась -> тег сменился -> старый хэш больше не
                # подходит. Соберите один раз, возьмите "got: sha256-..."
                # из ошибки и подставьте сюда.
                hash = "sha256-HqL8RlOe1A90IV25cvU21BkNSCcahCUsbsraK6z1D3Q=";
              };
              doCheck = false;

              build-system = [
                python3Packages.setuptools
                python3Packages.wheel
              ];

              dependencies = pythonDeps;

              optional-dependencies = with python3Packages; {
                build = [
                  pyinstaller
                ];
                dev = [
                  ruff
                ];
                test = testDeps;
              };

              # nixpkgs' pyqt6/defusedxml versions won't exactly match whatever
              # version G3M's pyproject.toml pins — this tells the build to accept
              # what's actually available instead of failing on a strict pin mismatch
              pythonRelaxDeps = [
                "PyQt6"
                "defusedxml"
                "rarfile"
              ];
              pythonImportsCheck = [ ]; # confirmed: no top-level "g3m" module — it's run as a script, not imported as a package

              nativeCheckInputs = [
                python3Packages.pytestCheckHook
                # реальный X-сервер + лёгкий WM — без них focus-out события
                # не доставляются так же, как в обычной сессии (см. preCheck)
                pkgs.xorg.xvfb
                pkgs.openbox
              ]
              ++ testDeps;

              # этот тест дёргает `git` и инспектирует закоммиченные файлы —
              # в sandbox'е нет ни .git, ни самого git, тесту там нечего делать
              disabledTests = [
                "test_removed_usage_reporting_has_no_tracked_references"
                # playsound3-фикс чинит его сам по себе — оставляем включённым как регресс-проверку
                # "test_background_audio_pause_detection_accepts_child_windows"
              ];
              devShells.default = pkgs.mkShell {
                # Drops you into a Python environment containing all production and testing dependencies
                packages = [
                  (pkgs.python3.withPackages (ps: pythonDeps ++ testDeps))
                ];
              };
              # focus-out тест ("test_search_mod_card_widget_expands_on_selection_and_hides_on_focus_loss")
              # НЕ в disabledTests — проверяем, действительно ли ему хватает
              # настоящего X + WM (см. preCheck ниже). Если снова упадёт —
              # значит дело не в среде, и его стоит вернуть в disabledTests
              # или чинить в самом коде.

              # запускаем настоящий Xvfb + openbox вместо offscreen-платформы
              # Qt — только так focus-out события доставляются так же, как
              # в обычной desktop-сессии, а не эмулируются приблизительно
              preCheck = ''
                export HOME=$(mktemp -d)
                export QT_QPA_PLATFORM=xcb
                export DISPLAY=:99

                Xvfb :99 -screen 0 1920x1080x24 &
                xvfb_pid=$!
                sleep 2

                openbox --sm-disable &
                wm_pid=$!
                sleep 1
              '';

              # сборочная песочница всё равно уничтожается сразу после
              # checkPhase, но прибраться за собой — хороший тон
              postCheck = ''
                kill "$wm_pid" 2>/dev/null || true
                kill "$xvfb_pid" 2>/dev/null || true
              '';

              nativeBuildInputs = [
                pkgs.makeWrapper
                # G3MTool в исходниках G3M нет вообще — офиц. CI собирает
                # его отдельно из y114git/G3MTool (это .NET/dotnet-проект,
                # см. build-g3m.yml) и кладёт в assets/bin/g3mtool_linux/
                # ПЕРЕД сборкой. При сборке с нуля из git-исходников
                # "G3MTool not found" в логах — ожидаемо, не баг nix-пакета.
                # autoPatchelfHook оставлен на случай, если G3MTool будет
                # добавлен сюда позже (см. TODO ниже) — сейчас патчить нечего.
                autoPatchelfHook
                # копирует всё из desktopItems в $out/share/applications/
                copyDesktopItems
              ];

              # .desktop-файл для меню приложений + регистрация g3m:// и
              # deltahub:// как обработчиков схем (см. README: "g3m:// is
              # the primary scheme, legacy deltahub:// links are still
              # accepted" — то же самое, что PyInstaller-сборка прописывает
              # через macOS bundle URL scheme metadata, только для Linux).
              desktopItems = [
                (makeDesktopItem {
                  name = "g3m";
                  exec = "g3m";
                  icon = "g3m";
                  desktopName = "G3M";
                  genericName = "GameMaker Mod Manager";
                  comment = "Desktop mod manager for GameMaker games";
                  categories = [
                    "Game"
                    "Utility"
                  ];
                  mimeTypes = [
                    "x-scheme-handler/g3m"
                    "x-scheme-handler/deltahub"
                  ];
                })
              ];

              # buildPythonApplication has nothing to auto-generate bin/g3m from,
              # since G3M has no [project.scripts] entry point (its own README
              # runs it via `python src/main.py`, not an installed command).
              # Real entry point is src/main.py (confirmed from source: it has
              # `if __name__ == "__main__": sys.exit(main())`, and main() does
              # `from app.startup import run_app`). NOTE: there is ALSO an
              # unrelated src/app/window/main.py in the tree — an earlier
              # version of this file located the entry via
              # `find ... -name main.py -print -quit`, which is not guaranteed
              # to pick the right one depending on filesystem traversal order.
              # Hardcoding the confirmed path removes that ambiguity entirely.
              #
              # A plain `makeWrapper <interpreter> $out/bin/g3m --add-flags main_py`
              # was tried first, but that bypasses buildPythonApplication's own
              # dependency wiring entirely — its automatic PYTHONPATH injection
              # only patches scripts it recognizes as Python entry points, and a
